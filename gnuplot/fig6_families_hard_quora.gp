# Quora 523K -- fig6_families_hard_quora
# Generated by code/gnuplot_figs.py from the TSV and .style beside it.
# Colour and dash are the figure module's own encoding, read from .style:
# one panel; see the .tsv header for the blocks.
set terminal pdfcairo size 5.2in,3.4in font "Helvetica,9" noenhanced
set output "fig6_families_hard_quora.pdf"

# --- house style: seaborn darkgrid, as the matplotlib figures use -----------
set style line 101 lc rgb "#FFFFFF" lw 1.1 dt 1
set style line 102 lc rgb "#FFFFFF" lw 0.6 dt 1
set grid xtics ytics back ls 101, ls 102
set border 0
set tics nomirror scale 0 textcolor rgb "#262626" font ",7"
set xlabel textcolor rgb "#262626"
set ylabel textcolor rgb "#262626"
set title textcolor rgb "#262626"
set key textcolor rgb "#262626"
# the panel itself; `behind` puts it under the white grid
set object 1 rectangle from graph 0,0 to graph 1,1 behind \
    fillcolor rgb "#EAEAF2" fillstyle solid 1.0 noborder
set autoscale xfix
set offsets graph 0.03, graph 0.03, graph 0.04, graph 0.02
set key off

set logscale x
set yrange [0.8:1.003]
set title "Quora 523K" font ",9"
set xlabel "search time per query (ms)"
set ylabel "recall@10"
set key bottom right maxcols 2 samplen 2.4 spacing 1.1 font ",7" textcolor rgb "#262626"
plot \
  "fig6_families_hard_quora.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#EA3323" title "HNSW / Vanilla", \
  "fig6_families_hard_quora.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 1 pt 5 ps 0.32 pi 2 lc rgb "#EA3323" title "HNSW / SYN", \
  "fig6_families_hard_quora.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 2 pt 9 ps 0.32 pi 2 lc rgb "#0000F5" title "NSG / Vanilla", \
  "fig6_families_hard_quora.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 9 ps 0.32 pi 2 lc rgb "#0000F5" title "NSG / SYN", \
  "fig6_families_hard_quora.tsv" index 4 using 1:2 with linespoints lw 1.4 dt 2 pt 13 ps 0.32 pi 2 lc rgb "#2E7D32" title "IVF / Vanilla", \
  "fig6_families_hard_quora.tsv" index 5 using 1:2 with linespoints lw 1.4 dt 1 pt 13 ps 0.32 pi 2 lc rgb "#2E7D32" title "IVF / SYN", \
  "fig6_families_hard_quora.tsv" index 6 using 1:2 with linespoints lw 1.4 dt 2 pt 11 ps 0.32 pi 2 lc rgb "#D97706" title "Vamana (DiskANN) / Vanilla", \
  "fig6_families_hard_quora.tsv" index 7 using 1:2 with linespoints lw 1.4 dt 1 pt 11 ps 0.32 pi 2 lc rgb "#D97706" title "Vamana (DiskANN) / SYN"
