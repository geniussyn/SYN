# Figure A1 -- composed with NGFix, hard decile
# Generated by code/gnuplot_figs.py from the TSV and .style beside it.
# Colour and dash are the figure module's own encoding, read from .style:
# the repair stage.
set terminal pdfcairo size 7.2in,2.6in font "Linux Libertine O,9" noenhanced
set output "paper_figA1_ngfix_hard.pdf"

# --- house style: seaborn darkgrid, as the matplotlib figures use -----------
set style line 101 lc rgb "#FFFFFF" lw 1.1 dt 1
set style line 102 lc rgb "#FFFFFF" lw 0.6 dt 1
set grid xtics ytics back ls 101, ls 102
set border 0
set tics nomirror scale 0 textcolor rgb "#262626" font ",7"
set xlabel textcolor rgb "#262626"
set ylabel textcolor rgb "#262626"
set title textcolor rgb "#262626"
set key textcolor rgb "#262626"
# the panel itself; `behind` puts it under the white grid
set object 1 rectangle from graph 0,0 to graph 1,1 behind \
    fillcolor rgb "#EAEAF2" fillstyle solid 1.0 noborder
set autoscale xfix
set offsets graph 0.03, graph 0.03, graph 0.04, graph 0.02
set key off

set logscale x
set yrange [0.7:1.003]
set key at screen 0.5,0.055 center bottom horizontal maxcols 4 samplen 2.4 spacing 1.1 font ",7" textcolor rgb "#262626"
set multiplot layout 1,4 margins 0.06,0.99,0.28,0.90 spacing 0.05,0.09

set title "MS MARCO 1M" font ",8" offset 0,-0.4
set xlabel "search time per query (ms)"
set ylabel "recall@10"
set key off
plot \
  "figA1_ngfix_hard_msmarco-1m.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "figA1_ngfix_hard_msmarco-1m.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "figA1_ngfix_hard_msmarco-1m.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "figA1_ngfix_hard_msmarco-1m.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

set title "FEVER 1M" font ",8" offset 0,-0.4
set xlabel "search time per query (ms)"
unset ylabel
set key off
plot \
  "figA1_ngfix_hard_fever.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "figA1_ngfix_hard_fever.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "figA1_ngfix_hard_fever.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "figA1_ngfix_hard_fever.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

set title "NQ 1M" font ",8" offset 0,-0.4
set xlabel "search time per query (ms)"
unset ylabel
set key off
plot \
  "figA1_ngfix_hard_nq.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "figA1_ngfix_hard_nq.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "figA1_ngfix_hard_nq.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "figA1_ngfix_hard_nq.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

set title "Quora 523K" font ",8" offset 0,-0.4
set xlabel "search time per query (ms)"
unset ylabel
set key off
set key on
plot \
  "figA1_ngfix_hard_quora.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "figA1_ngfix_hard_quora.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "figA1_ngfix_hard_quora.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "figA1_ngfix_hard_quora.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  1/0 with linespoints lw 1.4 dt 2 pt 7 ps 0.32 lc rgb "#EA3323" title "no repair", \
  1/0 with linespoints lw 1.4 dt 1 pt 3 ps 0.32 lc rgb "#EA3323" title "HNSW-NGFix", \
  1/0 with lines lw 2.0 dt 2 lc rgb "#EA3323" title "Vanilla", \
  1/0 with lines lw 2.0 dt 2 lc rgb "#0000F5" title "SYN"

unset multiplot
