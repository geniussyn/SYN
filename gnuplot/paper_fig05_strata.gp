# Figure 5 -- recall against search time on strata
# Generated by code/gnuplot_figs.py from the TSV and .style beside it.
# Colour and dash are the figure module's own encoding, read from .style:
# the difficulty stratum.
set terminal pdfcairo size 7.0in,4.4in font "Helvetica,9" noenhanced
set output "paper_fig05_strata.pdf"

# --- house style: seaborn darkgrid, as the matplotlib figures use -----------
set style line 101 lc rgb "#FFFFFF" lw 1.1 dt 1
set style line 102 lc rgb "#FFFFFF" lw 0.6 dt 1
set grid xtics ytics back ls 101, ls 102
set border 0
set tics nomirror scale 0 textcolor rgb "#262626" font ",7"
set xlabel textcolor rgb "#262626"
set ylabel textcolor rgb "#262626"
set title textcolor rgb "#262626"
set key textcolor rgb "#262626"
# the panel itself; `behind` puts it under the white grid
set object 1 rectangle from graph 0,0 to graph 1,1 behind \
    fillcolor rgb "#EAEAF2" fillstyle solid 1.0 noborder
set autoscale xfix
set offsets graph 0.03, graph 0.03, graph 0.04, graph 0.02
set key off

set logscale x
set yrange [0.3:1.003]
set multiplot layout 2,3 margins 0.07,0.99,0.19,0.94 spacing 0.06,0.10

set title "MS MARCO 1M" font ",8" offset 0,-0.4
unset xlabel
set ylabel "recall@10"
set key off
plot \
  "fig5_strata_msmarco-1m.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-1m.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-1m.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-1m.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_msmarco-1m.tsv" index 4 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_msmarco-1m.tsv" index 5 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

set title "FEVER 1M" font ",8" offset 0,-0.4
unset xlabel
unset ylabel
set key off
plot \
  "fig5_strata_fever.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_fever.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_fever.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_fever.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_fever.tsv" index 4 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_fever.tsv" index 5 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

set title "MS COCO 588K" font ",8" offset 0,-0.4
unset xlabel
unset ylabel
set key off
plot \
  "fig5_strata_mscoco.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_mscoco.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_mscoco.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_mscoco.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_mscoco.tsv" index 4 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_mscoco.tsv" index 5 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

set title "Quora 523K" font ",8" offset 0,-0.4
set xlabel "search time per query (ms)"
set ylabel "recall@10"
set key off
plot \
  "fig5_strata_quora.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_quora.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_quora.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_quora.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_quora.tsv" index 4 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_quora.tsv" index 5 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

set title "mMARCO French 1M" font ",8" offset 0,-0.4
set xlabel "search time per query (ms)"
unset ylabel
set key off
plot \
  "fig5_strata_msmarco-fr.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-fr.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-fr.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-fr.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_msmarco-fr.tsv" index 4 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_msmarco-fr.tsv" index 5 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

set title "MS MARCO 8.8M" font ",8" offset 0,-0.4
set xlabel "search time per query (ms)"
unset ylabel
set key off
plot \
  "fig5_strata_msmarco-8m.tsv" index 0 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-8m.tsv" index 1 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-8m.tsv" index 2 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#EA3323" notitle, \
  "fig5_strata_msmarco-8m.tsv" index 3 using 1:2 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_msmarco-8m.tsv" index 4 using 1:2 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 pi 2 lc rgb "#0000F5" notitle, \
  "fig5_strata_msmarco-8m.tsv" index 5 using 1:2 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 pi 2 lc rgb "#0000F5" notitle

# ---- the key, in a panel of its own ----
set lmargin at screen 0.02
set rmargin at screen 0.98
set bmargin at screen 0.004
set tmargin at screen 0.085
unset border; unset tics; unset xlabel; unset ylabel
unset object 1; unset title; unset logscale
set xrange [0:1]; set yrange [0:1]
set key at screen 0.5,0.077 center top horizontal maxrows 1 samplen 2.4 spacing 1.1 font ",7" textcolor rgb "#262626"
plot \
  1/0 with linespoints lw 1.4 dt 1 pt 7 ps 0.32 lc rgb "#EA3323" title "Avg", \
  1/0 with linespoints lw 1.4 dt 2 pt 5 ps 0.32 lc rgb "#EA3323" title "decile (worst 10%)", \
  1/0 with linespoints lw 1.4 dt 4 pt 3 ps 0.32 lc rgb "#EA3323" title "1st pct (worst 1%)", \
  1/0 with lines lw 2.0 dt 1 lc rgb "#EA3323" title "Vanilla", \
  1/0 with lines lw 2.0 dt 1 lc rgb "#0000F5" title "SYN"

unset multiplot
