# Figure 12 -- hard-decile distributions of phi_1 and of recall@10
# Generated by code/gnuplot_figs.py from the TSV and .style beside it.
# Colour and dash are the figure module's own encoding, read from .style:
# colour is the arm; the dotted line is that arm's own mean.
set terminal pdfcairo size 7.2in,4.6in font "Helvetica,9" enhanced
set output "paper_fig12_distributions.pdf"

# --- house style: seaborn darkgrid, as the matplotlib figures use -----------
set style line 101 lc rgb "#FFFFFF" lw 1.1 dt 1
set style line 102 lc rgb "#FFFFFF" lw 0.6 dt 1
set grid xtics ytics back ls 101, ls 102
set border 0
set tics nomirror scale 0 textcolor rgb "#262626" font ",7"
set xlabel textcolor rgb "#262626"
set ylabel textcolor rgb "#262626"
set title textcolor rgb "#262626"
set key textcolor rgb "#262626"
# the panel itself; `behind` puts it under the white grid
set object 1 rectangle from graph 0,0 to graph 1,1 behind \
    fillcolor rgb "#EAEAF2" fillstyle solid 1.0 noborder
set autoscale xfix
set offsets graph 0.03, graph 0.03, graph 0.04, graph 0.02
set key off

set style fill transparent solid 0.45 border lc rgb "#FFFFFF"
set boxwidth 0.92 relative
set multiplot layout 2,4 margins 0.06,0.99,0.155,0.94 spacing 0.08,0.10

set title "MS MARCO 1M" font ",8" offset 0,-0.4
set xrange [0.4:10.6]
set xtics 1,1,10
set xlabel "{/Symbol j}_1"
set ylabel "density"
set yrange [0:*]
unset arrow
set arrow from 7.37393,graph 0 to 7.37393,graph 1 nohead lw 1.2 dt 3 lc rgb "#EA3323" front
set arrow from 4.52579,graph 0 to 4.52579,graph 1 nohead lw 1.2 dt 3 lc rgb "#0000F5" front
set label 1 "Vanilla 7.37\nSYN 4.53" at graph 0.97,0.93 right font ",7" tc rgb "#262626" front
set key off
plot \
  "fig12_dist_msmarco-1m.tsv" index 0 using 1:2 with boxes lc rgb "#EA3323" notitle, \
  "fig12_dist_msmarco-1m.tsv" index 1 using 1:2 with boxes lc rgb "#0000F5" notitle
unset label 1

set title "FEVER 1M" font ",8" offset 0,-0.4
set xrange [0.4:10.6]
set xtics 1,1,10
set xlabel "{/Symbol j}_1"
unset ylabel
set yrange [0:*]
unset arrow
set arrow from 8.1949,graph 0 to 8.1949,graph 1 nohead lw 1.2 dt 3 lc rgb "#EA3323" front
set arrow from 5.21889,graph 0 to 5.21889,graph 1 nohead lw 1.2 dt 3 lc rgb "#0000F5" front
set label 1 "Vanilla 8.19\nSYN 5.22" at graph 0.97,0.93 right font ",7" tc rgb "#262626" front
set key off
plot \
  "fig12_dist_fever.tsv" index 0 using 1:2 with boxes lc rgb "#EA3323" notitle, \
  "fig12_dist_fever.tsv" index 1 using 1:2 with boxes lc rgb "#0000F5" notitle
unset label 1

set title "NQ 1M" font ",8" offset 0,-0.4
set xrange [0.4:10.6]
set xtics 1,1,10
set xlabel "{/Symbol j}_1"
unset ylabel
set yrange [0:*]
unset arrow
set arrow from 7.06957,graph 0 to 7.06957,graph 1 nohead lw 1.2 dt 3 lc rgb "#EA3323" front
set arrow from 5.41449,graph 0 to 5.41449,graph 1 nohead lw 1.2 dt 3 lc rgb "#0000F5" front
set label 1 "Vanilla 7.07\nSYN 5.41" at graph 0.97,0.93 right font ",7" tc rgb "#262626" front
set key off
plot \
  "fig12_dist_nq.tsv" index 0 using 1:2 with boxes lc rgb "#EA3323" notitle, \
  "fig12_dist_nq.tsv" index 1 using 1:2 with boxes lc rgb "#0000F5" notitle
unset label 1

set title "Quora 523K" font ",8" offset 0,-0.4
set xrange [0.4:10.6]
set xtics 1,1,10
set xlabel "{/Symbol j}_1"
unset ylabel
set yrange [0:*]
unset arrow
set arrow from 3.641,graph 0 to 3.641,graph 1 nohead lw 1.2 dt 3 lc rgb "#EA3323" front
set arrow from 3.195,graph 0 to 3.195,graph 1 nohead lw 1.2 dt 3 lc rgb "#0000F5" front
set label 1 "Vanilla 3.64\nSYN 3.19" at graph 0.97,0.93 right font ",7" tc rgb "#262626" front
set key off
plot \
  "fig12_dist_quora.tsv" index 0 using 1:2 with boxes lc rgb "#EA3323" notitle, \
  "fig12_dist_quora.tsv" index 1 using 1:2 with boxes lc rgb "#0000F5" notitle
unset label 1

unset title
set xrange [-0.08:1.08]
set xtics 0,0.2,1
set xlabel "Recall\\@10   (ef = 64)"
set ylabel "density"
set yrange [0:*]
unset arrow
set arrow from 0.517765,graph 0 to 0.517765,graph 1 nohead lw 1.2 dt 3 lc rgb "#EA3323" front
set arrow from 0.876504,graph 0 to 0.876504,graph 1 nohead lw 1.2 dt 3 lc rgb "#0000F5" front
set label 1 "Vanilla 0.518\nSYN 0.877" at graph 0.97,0.93 right font ",7" tc rgb "#262626" front
set key off
plot \
  "fig12_dist_msmarco-1m.tsv" index 2 using 1:2 with boxes lc rgb "#EA3323" notitle, \
  "fig12_dist_msmarco-1m.tsv" index 3 using 1:2 with boxes lc rgb "#0000F5" notitle
unset label 1

unset title
set xrange [-0.08:1.08]
set xtics 0,0.2,1
set xlabel "Recall\\@10   (ef = 64)"
unset ylabel
set yrange [0:*]
unset arrow
set arrow from 0.407046,graph 0 to 0.407046,graph 1 nohead lw 1.2 dt 3 lc rgb "#EA3323" front
set arrow from 0.745877,graph 0 to 0.745877,graph 1 nohead lw 1.2 dt 3 lc rgb "#0000F5" front
set label 1 "Vanilla 0.407\nSYN 0.746" at graph 0.97,0.93 right font ",7" tc rgb "#262626" front
set key off
plot \
  "fig12_dist_fever.tsv" index 2 using 1:2 with boxes lc rgb "#EA3323" notitle, \
  "fig12_dist_fever.tsv" index 3 using 1:2 with boxes lc rgb "#0000F5" notitle
unset label 1

unset title
set xrange [-0.08:1.08]
set xtics 0,0.2,1
set xlabel "Recall\\@10   (ef = 64)"
unset ylabel
set yrange [0:*]
unset arrow
set arrow from 0.624638,graph 0 to 0.624638,graph 1 nohead lw 1.2 dt 3 lc rgb "#EA3323" front
set arrow from 0.816522,graph 0 to 0.816522,graph 1 nohead lw 1.2 dt 3 lc rgb "#0000F5" front
set label 1 "Vanilla 0.625\nSYN 0.817" at graph 0.97,0.93 right font ",7" tc rgb "#262626" front
set key off
plot \
  "fig12_dist_nq.tsv" index 2 using 1:2 with boxes lc rgb "#EA3323" notitle, \
  "fig12_dist_nq.tsv" index 3 using 1:2 with boxes lc rgb "#0000F5" notitle
unset label 1

unset title
set xrange [-0.08:1.08]
set xtics 0,0.2,1
set xlabel "Recall\\@10   (ef = 64)"
unset ylabel
set yrange [0:*]
unset arrow
set arrow from 0.8823,graph 0 to 0.8823,graph 1 nohead lw 1.2 dt 3 lc rgb "#EA3323" front
set arrow from 0.9317,graph 0 to 0.9317,graph 1 nohead lw 1.2 dt 3 lc rgb "#0000F5" front
set label 1 "Vanilla 0.882\nSYN 0.932" at graph 0.97,0.93 right font ",7" tc rgb "#262626" front
set key off
plot \
  "fig12_dist_quora.tsv" index 2 using 1:2 with boxes lc rgb "#EA3323" notitle, \
  "fig12_dist_quora.tsv" index 3 using 1:2 with boxes lc rgb "#0000F5" notitle
unset label 1

# ---- the key, in a panel of its own ----
set lmargin at screen 0.02
set rmargin at screen 0.98
set bmargin at screen 0.004
set tmargin at screen 0.085
unset border; unset tics; unset xlabel; unset ylabel
unset object 1; unset title; unset arrow; unset label 1
set xrange [0:1]; set yrange [0:1]
set key at screen 0.5,0.077 center top horizontal maxrows 1 samplen 2.0 spacing 1.1 font ",7" textcolor rgb "#262626"
plot \
  1/0 with boxes lc rgb "#EA3323" title "Vanilla", \
  1/0 with boxes lc rgb "#0000F5" title "SYN"

unset multiplot
