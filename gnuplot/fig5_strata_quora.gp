# Difficulty strata -- fig5_strata_quora
# Generated by code/gnuplot_all.py. Needs gnuplot >= 5.2 and pdfcairo.
# noenhanced throughout: series names carry underscores and @ that would
# otherwise be read as markup.
# Colour is the arm, red Vanilla and blue SYN, as in the paper. The dash
# pattern carries whatever else the panel varies -- the stratum, the index
# family, the encoder.
set terminal pdfcairo size 5.2in,3.4in font "Helvetica,10" noenhanced
set output "fig5_strata_quora.pdf"
set grid lw 0.35 lc rgb "#dbdbdb"
set key bottom right spacing 1.1 samplen 2 font ",7"
# tight to the data: log autoscale otherwise pads out to the next decade
set autoscale xfix
set offsets graph 0.02, graph 0.02, graph 0.04, graph 0.02

set logscale x
set xlabel "search time per query (ms)"
set ylabel "recall@10"
set yrange [0.45:1.010]
plot \
  "fig5_strata_quora.tsv" index 0 using 1:2 with lines lw 1.6 dt 1 lc rgb "#EA3323" title "Vanilla / Avg", \
  "fig5_strata_quora.tsv" index 1 using 1:2 with lines lw 1.6 dt 2 lc rgb "#EA3323" title "Vanilla / decile (worst 10%)", \
  "fig5_strata_quora.tsv" index 2 using 1:2 with lines lw 1.6 dt 4 lc rgb "#EA3323" title "Vanilla / 5th pct (worst 5%)", \
  "fig5_strata_quora.tsv" index 3 using 1:2 with lines lw 1.6 dt 5 lc rgb "#EA3323" title "Vanilla / 1st pct (worst 1%)", \
  "fig5_strata_quora.tsv" index 4 using 1:2 with lines lw 1.6 dt 3 lc rgb "#EA3323" title "SYN / Avg", \
  "fig5_strata_quora.tsv" index 5 using 1:2 with lines lw 1.6 dt 6 lc rgb "#EA3323" title "SYN / decile (worst 10%)", \
  "fig5_strata_quora.tsv" index 6 using 1:2 with lines lw 1.6 dt 7 lc rgb "#EA3323" title "SYN / 5th pct (worst 5%)", \
  "fig5_strata_quora.tsv" index 7 using 1:2 with lines lw 1.6 dt 8 lc rgb "#EA3323" title "SYN / 1st pct (worst 1%)"
