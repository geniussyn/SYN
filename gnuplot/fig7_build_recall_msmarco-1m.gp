# Build cost -- fig7_build_recall_msmarco-1m
# Generated by code/gnuplot_all.py. Needs gnuplot >= 5.2 and pdfcairo.
# noenhanced throughout: series names carry underscores and @ that would
# otherwise be read as markup.
# Colour is the arm, red Vanilla and blue SYN, as in the paper. The dash
# pattern carries whatever else the panel varies -- the stratum, the index
# family, the encoder.
set terminal pdfcairo size 4.6in,3.2in font "Helvetica,10" noenhanced
set output "fig7_build_recall_msmarco-1m.pdf"
set grid lw 0.35 lc rgb "#dbdbdb"
set key bottom right spacing 1.1 samplen 2 font ",7"
# tight to the data: log autoscale otherwise pads out to the next decade
set autoscale xfix
set offsets graph 0.02, graph 0.02, graph 0.04, graph 0.02

set xlabel "HNSW degree M"
set ylabel "recall@10 (hard decile)"
set yrange [0.63:1.008]
plot \
  "fig7_build_recall_msmarco-1m.tsv" index 0 using 1:2 with lines lw 1.6 dt 1 lc rgb "#EA3323" title "Vanilla / budget 1 ms", \
  "fig7_build_recall_msmarco-1m.tsv" index 1 using 1:2 with lines lw 1.6 dt 2 lc rgb "#EA3323" title "SYN / budget 1 ms", \
  "fig7_build_recall_msmarco-1m.tsv" index 2 using 1:2 with lines lw 1.6 dt 4 lc rgb "#EA3323" title "Vanilla / budget 5 ms", \
  "fig7_build_recall_msmarco-1m.tsv" index 3 using 1:2 with lines lw 1.6 dt 5 lc rgb "#EA3323" title "SYN / budget 5 ms"
