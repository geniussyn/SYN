# Encoders -- fig9_encoders_msmarco-1m
# Generated by code/gnuplot_all.py. Needs gnuplot >= 5.2 and pdfcairo.
# noenhanced throughout: series names carry underscores and @ that would
# otherwise be read as markup.
# Colour is the arm, red Vanilla and blue SYN, as in the paper. The dash
# pattern carries whatever else the panel varies -- the stratum, the index
# family, the encoder.
set terminal pdfcairo size 5.6in,3.4in font "Helvetica,10" noenhanced
set output "fig9_encoders_msmarco-1m.pdf"
set grid lw 0.35 lc rgb "#dbdbdb"
set key bottom right spacing 1.1 samplen 2 font ",7"
# tight to the data: log autoscale otherwise pads out to the next decade
set autoscale xfix
set offsets graph 0.02, graph 0.02, graph 0.04, graph 0.02

set logscale x
set xlabel "search time per query (ms)"
set ylabel "recall@10 (hard decile)"
set yrange [0.30:1.007]
plot \
  "fig9_encoders_msmarco-1m.tsv" index 0 using 1:2 with lines lw 1.6 dt 1 lc rgb "#EA3323" title "MiniLM-L6 (384d) / Vanilla", \
  "fig9_encoders_msmarco-1m.tsv" index 1 using 1:2 with lines lw 1.6 dt 2 lc rgb "#0000F5" title "MiniLM-L6 (384d) / SYN", \
  "fig9_encoders_msmarco-1m.tsv" index 2 using 1:2 with lines lw 1.6 dt 4 lc rgb "#EA3323" title "BGE-M3 (1024d) / Vanilla", \
  "fig9_encoders_msmarco-1m.tsv" index 3 using 1:2 with lines lw 1.6 dt 5 lc rgb "#0000F5" title "BGE-M3 (1024d) / SYN", \
  "fig9_encoders_msmarco-1m.tsv" index 4 using 1:2 with lines lw 1.6 dt 3 lc rgb "#EA3323" title "E5-large (1024d) / Vanilla", \
  "fig9_encoders_msmarco-1m.tsv" index 5 using 1:2 with lines lw 1.6 dt 6 lc rgb "#0000F5" title "E5-large (1024d) / SYN", \
  "fig9_encoders_msmarco-1m.tsv" index 6 using 1:2 with lines lw 1.6 dt 7 lc rgb "#EA3323" title "GTE-large (1024d) / Vanilla", \
  "fig9_encoders_msmarco-1m.tsv" index 7 using 1:2 with lines lw 1.6 dt 8 lc rgb "#0000F5" title "GTE-large (1024d) / SYN", \
  "fig9_encoders_msmarco-1m.tsv" index 8 using 1:2 with lines lw 1.6 dt 1 lc rgb "#EA3323" title "Qwen3-4B (2560d) / Vanilla", \
  "fig9_encoders_msmarco-1m.tsv" index 9 using 1:2 with lines lw 1.6 dt 2 lc rgb "#0000F5" title "Qwen3-4B (2560d) / SYN"
